# Cube.js API Configuration
# Copy this file to .env and fill in your actual values
VITE_CUBEJS_API_URL=https://your-cubejs-instance.cubecloudapp.dev/cubejs-api/v1
VITE_CUBEJS_AUTH_TOKEN=your_actual_jwt_token_here

# For local development, you can also use:
# VITE_CUBEJS_API_URL=http://localhost:4000/cubejs-api/v1
